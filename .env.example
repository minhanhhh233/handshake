PUBLIC_BASE_URL=http://127.0.0.1:8000
ADMIN_KEY=
OFFER_TTL_SECONDS=120
APPROVAL_TTL_SECONDS=3600
UPSTREAM_CACHE_TTL_SECONDS=60
